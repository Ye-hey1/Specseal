# 拷贝为 .env 后填值（.env 已入 .gitignore，不进版本控制）。
#   cp .env.example .env

# PostgreSQL profile 必填：数据库密码（同一值同时初始化 postgres 服务
# 与补全 server 的连接 URL）。
SPECSEAL_POSTGRES_PASSWORD=

# 对外网址：浏览器实际使用的 scheme://host:port（同源检查与 setup 链接都以此为准）。
#SPECSEAL_PUBLIC_URL=http://localhost:8080

# 对外端口映射（容器内固定 8080）。
#SPECSEAL_PORT=8080
