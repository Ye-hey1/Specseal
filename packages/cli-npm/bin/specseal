#!/usr/bin/env node
// @specseal/cli 的 shim（cli-distribution spec「CLI 以 npm 套件发布」；release-assets-trim
// 设计 D4）：找到本机平台子套件内的 specseal binary，以继承 stdio 的方式运行，exit code
// 与信号原样带回。macOS／Linux 上 postinstall 会把这个档原地换成原生 binary，之后不再
// 经过 Node；这里是 Windows 的正式路径，以及 --ignore-scripts 安装的退路。
import { spawnSync } from 'node:child_process';
import process from 'node:process';
import { resolveBinary, SUPPORTED_PLATFORMS } from '../platform.mjs';

const binary = resolveBinary(import.meta.url, process.platform, process.arch);
if (!binary) {
  process.stderr.write(
    `specseal: 找不到 ${process.platform}-${process.arch} 的 CLI binary。` +
      `支持的平台：${SUPPORTED_PLATFORMS.join('、')}；` +
      '若平台在列，请确认安装时未略过 optionalDependencies（重新运行 npm i -g @specseal/cli）。\n',
  );
  process.exit(1);
}

const result = spawnSync(binary, process.argv.slice(2), { stdio: 'inherit' });
if (result.error) {
  process.stderr.write(`specseal: 无法运行 ${binary}：${result.error.message}\n`);
  process.exit(1);
}
if (result.signal) {
  // 子行程被信号收束：对自己送同一个信号，调用端看到的终止方式一致。
  process.kill(process.pid, result.signal);
}
process.exit(result.status ?? 1);
