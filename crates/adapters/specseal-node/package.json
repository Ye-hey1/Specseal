{
  "name": "@specseal/engine",
  "version": "0.1.0",
  "//": "version 为占位符，不随 workspace 版本 bump；发布产物的版号一律由 release tag 于打包前盖章决定（scripts/npm/npm-engine-package.mjs，经 .github/workflows/node-sdk.yml 的 version 输入触发）",
  "description": "Specseal spec-driven development engine — Node.js bindings (napi-rs)",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js"
  ],
  "napi": {
    "name": "specseal-engine",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-pc-windows-msvc",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --js binding.js --dts binding.d.ts",
    "build:release": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "vitest": "^3.0.0"
  }
}
