# Rust build artifacts
/target/
# napi build 的隔离 target（见 crates/adapters/specseal-node/.cargo/config.toml）
/crates/adapters/specseal-node/target/

# Legacy app data
specseal/.vector-search.db*

# Specseal app data
.specseal/

# JS workspace (desktop app + shared UI + server web console)
node_modules/
apps/desktop/dist/
# 第三方授权清单：predev／prebuild 由 scripts/desktop/third-party-licenses.mjs 重生（desktop-about-page D3）
apps/desktop/src/generated/
apps/desktop/src-tauri/gen/
# Server Web Console 的 Vite 产物：不入版本控制，各 build path（dev／CI／Docker／
# release）皆重建后由 specseal-server 内嵌（D5）。
apps/server-web/dist/

# Deployment secrets（deploy/.env.example 是入版本控制的样板）
deploy/.env

# 本地开发编排（npm run dev；.env.example 是入版本控制的样板）
/.dev/
/.env

# macOS
.DS_Store
apps/desktop/src-tauri/binaries/

# Claude Code 加载 mod 时自动产生的类型档，每次加载都会重写
integrations/claude-code/*/.claude-plugin/types/
# Herdr 加载 mod 时写进文件夹的类型档与设置
integrations/herdr/mods/*/gpui-kit.d.ts
integrations/herdr/mods/*/herdr.d.ts
integrations/herdr/mods/*/jsconfig.json

# 品牌套件压缩档不进 repo（原稿在 docs/assets/brand/svg）
docs/assets/brand/*.zip
