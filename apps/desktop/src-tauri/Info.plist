<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 在地化声明（design D9）。Tauri 建置时自动合并进 bundle。
	     注意：光有这份声明不会让系统对话框（NSOpenPanel 等）跟随语系——AppKit
	     看的是 Contents/Resources/ 底下实际存在的 .lproj 目录。实际的目录由
	     tauri.conf.json 的 bundle.resources 自 localizations/ 拷贝进去；此处
	     必须与那些目录同名，声明了却没有对应目录的语言会被选中后无资源可用。
	     命名采 zh_TW 而非 zh-Hant：macOS 自家 app 与各大第三方 app 的 .lproj
	     一律是这个写法，zh-Hant 无实证。 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh_TW</string>
		<string>en</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
</dict>
</plist>
